# ================================
# Django environment configuration
# ================================

# Copy this file to .env
# NEVER commit .env to version control


# -------------------------------------------------------------------
# SECURITY
# -------------------------------------------------------------------

# REQUIRED IN PRODUCTION
# Used for cryptographic signing (sessions, cookies, password resets).
# Generate using:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=


# -------------------------------------------------------------------
# DEBUG MODE
# -------------------------------------------------------------------

# MUST be false in production.
# If true, Django exposes stack traces, settings, and internal paths.
DJANGO_DEBUG=true


# -------------------------------------------------------------------
# HOST VALIDATION
# -------------------------------------------------------------------

# Comma-separated list of allowed domains.
# Examples:
#   yourdomain.com
#   api.yourdomain.com
#   yourdomain.com,api.yourdomain.com
#
# NEVER use "*"
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# -------------------------------------------------------------------
# DEFAULT ADMIN CREATION
# -------------------------------------------------------------------

# Used ONLY for development or first-time setup.
#
# true  → auto-create default admin on empty DB (DEV ONLY)
# false → disables automatic admin creation (REQUIRED IN PRODUCTION)
#
# Production MUST be false.
ALLOW_CREATE_DEFAULT_USER=true
