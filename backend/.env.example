# Copy to .env and set in production. Do not commit .env.

# Required in production: set a long random secret
# DJANGO_SECRET_KEY=your-secret-key-here

# Set to false in production
# DJANGO_DEBUG=false

# Comma-separated list of allowed hosts (e.g. yourdomain.com,api.yourdomain.com)
# DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Set to false to disable auto-creation of default admin user on empty DB
# ALLOW_CREATE_DEFAULT_USER=false
